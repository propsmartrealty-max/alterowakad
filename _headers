# Global Security and Performance Headers for Cloudflare Pages
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Timing-Allow-Origin: *
  X-Permitted-Cross-Domain-Policies: none
  X-DNS-Prefetch-Control: on
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# Media and Static Assets Cache Optimization (1 Year Immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Core Stylesheets and Scripts
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Service Worker Cache Invalidation
/sw.js
  Cache-Control: public, max-age=0, must-revalidate, no-cache
  CDN-Cache-Control: max-age=0, no-cache, no-store
  Service-Worker-Allowed: /
  Content-Type: application/javascript; charset=utf-8

# SEO Crawl Discovery Files
/robots.txt
  Cache-Control: public, max-age=43200, s-maxage=43200

/sitemap.xml
  Cache-Control: public, max-age=43200, s-maxage=43200

/feed.xml
  Cache-Control: public, max-age=43200, s-maxage=43200
  Content-Type: application/rss+xml; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=43200, s-maxage=43200
  Content-Type: text/plain; charset=utf-8

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/.well-known/security.txt
  Cache-Control: public, max-age=43200, s-maxage=43200
  Content-Type: text/plain; charset=utf-8

